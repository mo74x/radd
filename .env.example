# Radd environment variables. Copy to .env and fill in.
# Everything marked "optional" falls back to a built-in mock when empty.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Secrets (required) ---
# 64-char hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# --- Google Business Profile (optional; "live" to use real APIs) ---
GOOGLE_API_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback

# --- AI (optional; simulator when empty) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- Email: Resend (optional) ---
RESEND_API_KEY=
EMAIL_FROM=Radd <onboarding@resend.dev>

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=

# --- WhatsApp Cloud API (optional) ---
META_WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=review_reply_approval
WHATSAPP_TEMPLATE_LANG=ar

# --- Paymob (optional) ---
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Fawry (optional) ---
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
